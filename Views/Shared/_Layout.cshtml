<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Quản lý kho hàng</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        header {
            background: #2c3e50;
            color: #fff;
            padding: 12px 20px;
            font-size: 18px;
        }

        footer {
            background: #ecf0f1;
            padding: 10px 20px;
            text-align: center;
            border-top: 1px solid #ccc;
        }

        .wrap {
            display: flex;
            min-height: 70vh;
        }

        nav {
            width: 230px;
            background: #f4f6f7;
            padding: 15px;
            border-right: 1px solid #ddd;
        }

            nav a {
                display: block;
                padding: 8px 0;
                color: #2c3e50;
                text-decoration: none;
            }

                nav a:hover {
                    text-decoration: underline;
                }

        main {
            flex: 1;
            padding: 20px;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 6px 10px;
            text-align: left;
        }

        th {
            background: #eee;
        }

        .error {
            color: #c0392b;
            margin: 8px 0;
        }

        .ok {
            color: #27ae60;
            margin: 8px 0;
        }

        .row {
            margin-bottom: 10px;
        }

        label {
            display: inline-block;
            width: 120px;
        }
    </style>
</head>
<body>
    <header>Họ tên: Nguyễn Bá Lộc &nbsp;|&nbsp; MSSV: 25dh230017</header>
    <div class="wrap">
        <nav>
            <b>MENU</b>
            @Html.ActionLink("Câu 2-3: Danh sách / Lọc / Sửa", "Index", "Products")
            @Html.ActionLink("Câu 4: Tăng / giảm giá", "Adjust", "Products")
            @Html.ActionLink("Câu 5: Giảm giá 2 sản phẩm", "DiscountTwo", "Products")
            @Html.ActionLink("Câu 6: Thêm sản phẩm", "Create", "Products")
            @Html.ActionLink("Câu 7: Thống kê", "Stats", "Products")
        </nav>
        <main>@RenderBody()</main>
    </div>
    <footer>Ngày sinh: 15/02/2007</footer>
</body>
</html>