@model Warehouse_25dh230017.Product
@{ ViewBag.Title = "Thêm sản phẩm"; }
<h2>Thêm sản phẩm mới</h2>
@Html.ValidationSummary(false, "", new { @class = "error" })
@using (Html.BeginForm("Create", "Products", FormMethod.Post))
{
    <div class="row"><label>Tên sản phẩm</label><input type="text" name="ProductName" value="@ViewBag.Name" /></div>
    <div class="row"><label>Danh mục</label><input type="text" name="Category" value="@ViewBag.Cat" /></div>
    <div class="row"><label>Đơn giá</label><input type="number" step="0.01" name="Price" value="@ViewBag.Pr" /></div>
    <div class="row"><label>Số lượng</label><input type="number" step="1" name="Quantity" value="@ViewBag.Qty" /></div>
    <button type="submit">Lưu</button>
}