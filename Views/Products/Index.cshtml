@model List<Warehouse_25dh230017.Product>
@{ ViewBag.Title = "Danh sách sản phẩm"; }
<h2>Danh sách sản phẩm</h2>

@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <div class="row">
        Từ giá: <input type="number" step="0.01" name="fromPrice" value="@ViewBag.FromPrice" />
        Đến giá: <input type="number" step="0.01" name="toPrice" value="@ViewBag.ToPrice" />
        Danh mục:
        @Html.DropDownList("category", (SelectList)ViewBag.Categories, "-- Tất cả --")
        Sắp xếp:
        <select name="sort">
            <option value="">Mặc định</option>
            <option value="asc" @(ViewBag.Sort == "asc" ? "selected" : "")>Giá tăng dần</option>
            <option value="desc" @(ViewBag.Sort == "desc" ? "selected" : "")>Giá giảm dần</option>
        </select>
        <button type="submit">Lọc</button>
    </div>
}

@if (ViewBag.Error != null)
{<div class="error">@ViewBag.Error</div>}

<table>
    <tr><th>ID</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Đơn giá</th><th>Tồn kho</th><th>Mức giá</th><th></th></tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProductID</td>
            <td>@p.ProductName</td>
            <td>@p.Category</td>
            <td>@p.Price.ToString("N0")</td>
            <td>@p.Quantity</td>
            <td>@p.PriceLevel</td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = p.ProductID }) |
                @Html.ActionLink("Điều chỉnh giá", "Adjust", new { id = p.ProductID })
            </td>
        </tr>
    }
</table>